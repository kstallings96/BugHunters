# Copy to .env.local for local development. Set the same names in Vercel
# (Production, Preview and Development). Never commit real values.

# --- Where data is saved ---
# supabase | file | none. Leave blank to choose automatically: Supabase if the
# two keys below are set, otherwise local files (or nothing, on Vercel).
DATA_STORE=
# Folder for local files. Default: <home>/bughunters-data, outside OneDrive,
# because these files contain students' first names.
LOG_DIR=

# --- Supabase (optional for now; server-side only, never NEXT_PUBLIC_) ---
# Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Sessions ---
# Signs session tokens. 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Study settings (all optional; defaults shown) ---
# random | A | B  (a ?form= URL parameter always overrides)
DEFAULT_FORM=random
# Share of sessions that get the "Ask the AI" checker (0-1). ?checker=on|off overrides.
AI_CHECKER_RATIO=0.5
# Seconds before testing ends on its own. Never shown to students.
HUNT_CAP_SECONDS=600
# One-item survey before step 1 and after step 6.
SURVEY_ENABLED=false

# --- Supabase CLI only (local machine, not Vercel) ---
SUPABASE_DB_PASSWORD=
# Optional: lets `npm run check-data` confirm the anon key can't read or write.
SUPABASE_ANON_KEY=
