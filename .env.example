# Copy to .env.local for local development. Set the same names in Vercel
# (Production, Preview and Development). Never commit real values.

# --- Where data is saved ---
# supabase | file | none. Leave blank to choose automatically: Supabase if the
# two keys below are set, otherwise local files (or nothing, on Vercel).
DATA_STORE=
# Folder for local files. Default: <home>/bughunters-data/v2, outside OneDrive,
# because these files contain students' first names.
LOG_DIR=

# --- Access ---
# Class code students type once per device. Case-insensitive.
ACCESS_CODE=

# --- Study settings (all optional; defaults shown) ---
# Class periods students pick from, comma-separated.
CLASS_PERIODS=1,2,3,4,5,6,7,8
# Seconds on one machine before "Ready for the next machine?" (never auto-advances).
NUDGE_SECONDS=180
# Decides what "today" means for "Keep going where you left off?".
SCHOOL_TIMEZONE=America/Chicago

# --- Supabase (optional for now; server-side only, never NEXT_PUBLIC_) ---
# Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Sessions ---
# Signs session tokens. 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=


# --- Supabase CLI only (local machine, not Vercel) ---
SUPABASE_DB_PASSWORD=
# Optional: lets `npm run check-data` confirm the anon key can't read or write.
SUPABASE_ANON_KEY=
