{
  "name": "bug-hunters",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "db:push": "supabase db push",
    "check-data": "node --env-file=.env.local scripts/check-data.mjs",
    "gen": "tsx --env-file=.env.local --tsconfig tsconfig.json scripts/generate.ts",
    "export": "tsx --conditions=react-server --env-file=.env.local --tsconfig tsconfig.json scripts/export.ts",
    "keys": "tsx --env-file=.env.local --tsconfig tsconfig.json scripts/keys.ts",
    "pull": "tsx --conditions=react-server --env-file=.env.local --tsconfig tsconfig.json scripts/pull.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@vercel/blob": "^2.8.1",
    "next": "16.4.0",
    "obscenity": "^0.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.2",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
